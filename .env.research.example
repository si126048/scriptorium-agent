# Copy values to your process environment or .env; do not commit secrets.
HERMENEUT_DATABASE_URL=postgresql+psycopg://hermeneut:CHANGE_ME@127.0.0.1:5432/hermeneut
HERMENEUT_OBJECT_ROOT=./data/research-objects
HERMENEUT_ELASTICSEARCH_URL=http://127.0.0.1:9200
HERMENEUT_RESEARCH_OWNER=local-user
HERMENEUT_RESEARCH_API_KEY=CHANGE_ME
HERMENEUT_POSTGRES_PASSWORD=CHANGE_ME
# Optional Worker recovery settings (positive integers).
# HERMENEUT_LEASE_SECONDS=300
# HERMENEUT_MAX_ATTEMPTS=3
# Optional immutable S3 object backend; bucket must already exist.
# HERMENEUT_OBJECT_BACKEND=s3
# HERMENEUT_S3_BUCKET=hermeneut
# HERMENEUT_S3_ENDPOINT=https://your-object-service
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional existing provider; never silently falls back to demo.
# DASHSCOPE_API_KEY=
# LACAN_MODEL=qwen-plus
