# Copy values to your process environment or .env; do not commit secrets.
SCRIPTORIUM_DATABASE_URL=postgresql+psycopg://scriptorium:CHANGE_ME@127.0.0.1:5432/scriptorium
SCRIPTORIUM_OBJECT_ROOT=./data/research-objects
SCRIPTORIUM_ELASTICSEARCH_URL=http://127.0.0.1:9200
SCRIPTORIUM_RESEARCH_OWNER=local-user
SCRIPTORIUM_RESEARCH_API_KEY=CHANGE_ME
SCRIPTORIUM_POSTGRES_PASSWORD=CHANGE_ME
# Optional Worker recovery settings (positive integers).
# SCRIPTORIUM_LEASE_SECONDS=300
# SCRIPTORIUM_MAX_ATTEMPTS=3
# Optional immutable S3 object backend; bucket must already exist.
# SCRIPTORIUM_OBJECT_BACKEND=s3
# SCRIPTORIUM_S3_BUCKET=scriptorium
# SCRIPTORIUM_S3_ENDPOINT=https://your-object-service
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# Optional existing provider; never silently falls back to demo.
# DASHSCOPE_API_KEY=
# LACAN_MODEL=qwen-plus
