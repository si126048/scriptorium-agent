<?xml version="1.0" encoding="UTF-8"?>
<!-- Hermeneut TEI P5 subset v1. Deliberately rejects unsupported structures. -->
<grammar xmlns="http://relaxng.org/ns/structure/1.0" ns="http://www.tei-c.org/ns/1.0">
  <start><element name="TEI"><ref name="attrs"/><element name="teiHeader"><ref name="attrs"/><oneOrMore><ref name="header"/></oneOrMore></element><element name="text"><ref name="attrs"/><element name="body"><ref name="attrs"/><oneOrMore><ref name="block"/></oneOrMore></element></element><optional><ref name="standOff"/></optional></element></start>
  <define name="attrs"><zeroOrMore><attribute><anyName/></attribute></zeroOrMore></define>
  <define name="header"><element><choice><name>fileDesc</name><name>titleStmt</name><name>title</name><name>publicationStmt</name><name>sourceDesc</name><name>p</name><name>revisionDesc</name><name>change</name><name>respStmt</name><name>resp</name><name>name</name><name>bibl</name><name>author</name><name>publisher</name><name>date</name></choice><ref name="attrs"/><mixed><zeroOrMore><ref name="header"/></zeroOrMore></mixed></element></define>
  <define name="inline"><element><choice><name>seg</name><name>quote</name><name>note</name><name>hi</name><name>unclear</name><name>gap</name><name>choice</name><name>sic</name><name>corr</name><name>add</name><name>del</name><name>anchor</name><name>lb</name></choice><ref name="attrs"/><mixed><zeroOrMore><ref name="inline"/></zeroOrMore></mixed></element></define>
  <define name="block"><choice><element name="div"><ref name="attrs"/><oneOrMore><ref name="block"/></oneOrMore></element><element name="pb"><ref name="attrs"/><empty/></element><element><choice><name>p</name><name>head</name><name>note</name></choice><ref name="attrs"/><mixed><zeroOrMore><ref name="inline"/></zeroOrMore></mixed></element></choice></define>
  <define name="standOff"><element name="standOff"><ref name="attrs"/><zeroOrMore><choice><element name="note"><ref name="attrs"/><text/></element><element name="spanGrp"><ref name="attrs"/><zeroOrMore><element name="span"><ref name="attrs"/><text/></element></zeroOrMore></element><element name="linkGrp"><ref name="attrs"/><zeroOrMore><element name="link"><ref name="attrs"/><empty/></element></zeroOrMore></element></choice></zeroOrMore></element></define>
</grammar>
