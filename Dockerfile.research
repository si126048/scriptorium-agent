FROM node:24-slim AS frontend
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md requirements-research.lock ./
COPY hermeneut/ hermeneut/
RUN pip install --no-cache-dir -c requirements-research.lock '.[research]'
COPY alembic-research.ini ./
COPY migrations/research/ migrations/research/
COPY --from=frontend /web/dist/ web/dist/
RUN useradd -m -r hermeneut && mkdir -p /data/objects && chown -R hermeneut /data
USER hermeneut
EXPOSE 8010
CMD ["hermeneut-research", "serve", "--host", "0.0.0.0", "--port", "8010"]
