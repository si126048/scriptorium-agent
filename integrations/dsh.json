[
  {
    "id": "mcp-scriptorium",
    "name": "@deepseek-ai/dsh-mcp-client",
    "config": {
      "serverName": "scriptorium",
      "transport": "stdio",
      "command": "python",
      "args": [
        "-m",
        "scriptorium.plugin",
        "mcp",
        "--workspace",
        "/ABSOLUTE/PATH/TO/WORKSPACE"
      ],
      "cwd": "/ABSOLUTE/PATH/TO/WORKSPACE",
      "failOnStartupError": true
    }
  }
]
