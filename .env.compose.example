# Copy to .env.compose and edit before running Docker Compose.
#
#   cp .env.compose.example .env.compose
#   docker compose -f compose.research.lite.yml --env-file .env.compose up -d --build
#
# scripts/quickstart.py --docker generates this file with a random database password.

# Required: URL-safe password (letters, digits, - _ . ~ only).
SCRIPTORIUM_POSTGRES_PASSWORD=change-me-url-safe

# Optional: require a bearer token for non-loopback clients. Leave empty for a local-only setup.
SCRIPTORIUM_RESEARCH_API_KEY=

# Optional: model provider key. You can also save one later in the workbench UI.
DASHSCOPE_API_KEY=
LACAN_MODEL=qwen-plus
